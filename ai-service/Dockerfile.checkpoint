FROM ghcr.io/astral-sh/uv:0.10.11 AS uv
FROM python:3.12.12-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /workspace
COPY ai-service/requirements-m3.lock ./requirements-m3.lock
RUN uv venv /workspace/.venv && uv pip install --python /workspace/.venv/bin/python --require-hashes -r requirements-m3.lock
COPY ai-service/app ./app
COPY scripts/check_checkpoint.py ./check_checkpoint.py
RUN useradd --create-home app
USER app
ENTRYPOINT ["/workspace/.venv/bin/python", "/workspace/check_checkpoint.py"]
